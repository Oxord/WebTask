# Скопируйте в .env и при необходимости поменяйте порты.
# Без .env проект тоже запустится: docker-compose.yml подставит эти же значения
# по умолчанию.

APP_ENV=dev
APP_DEBUG=true

# Порт сайта на вашей машине. Если 8081 занят — достаточно поменять только здесь.
WEB_PORT=8081

# APP_URL можно не задавать: пустое значение = относительные ссылки, работает на любом
# порту. Заполняйте, только если нужны абсолютные URL (например, за реверс-прокси).
APP_URL=

# Подключение приложения к БД внутри сети Docker (менять не нужно).
DB_HOST=db
DB_PORT=3306
DB_NAME=decor_home
DB_USER=decor
DB_PASS=decor_secret
DB_ROOT_PASS=root_secret

# Порт MySQL, проброшенный на вашу машину — нужен только для GUI-клиента.
DB_PORT_HOST=3307

# База для интеграционных тестов (поднимается в tmpfs, чистится при рестарте).
TEST_DB_HOST=db_test
TEST_DB_NAME=decor_test
